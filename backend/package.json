{
  "name": "finance-copilot-backend",
  "version": "1.0.0",
  "description": "API for Finance Copilot: transaction tracking, spending analytics, and an AI assistant.",
  "main": "server.js",
  "private": true,
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "start": "node server.js",
    "dev": "node --watch server.js",
    "test": "node --test test/*.test.js",
    "gen-secret": "node -e \"console.log(require('crypto').randomBytes(48).toString('hex'))\"",
    "vendor:chart": "cp node_modules/chart.js/dist/chart.umd.min.js ../frontend/vendor/chart.umd.min.js"
  },
  "keywords": [
    "finance",
    "budgeting",
    "express"
  ],
  "license": "MIT",
  "dependencies": {
    "bcryptjs": "^3.0.2",
    "cors": "^2.8.5",
    "dotenv": "^17.2.2",
    "express": "^5.1.0",
    "express-rate-limit": "^8.6.1",
    "jsonwebtoken": "^9.0.2",
    "openai": "^5.23.0",
    "sqlite3": "^5.1.7"
  },
  "devDependencies": {
    "chart.js": "^4.5.1",
    "supertest": "^7.2.2"
  }
}
