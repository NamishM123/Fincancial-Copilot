# Copy to .env and fill in. Never commit the real .env.

# REQUIRED. Signs session tokens. Must be at least 32 characters.
# Generate one with: npm run gen-secret
JWT_SECRET=

# How long a login stays valid.
JWT_EXPIRES_IN=24h

# Port the API listens on.
PORT=3000

# SQLite file location, relative to the backend directory.
DATABASE_FILE=finance.db

# OPTIONAL. Without it the assistant answers from the built-in analytics
# instead of a language model.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_MAX_TOKENS=500
